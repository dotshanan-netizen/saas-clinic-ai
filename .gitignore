# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# boilerplate backup (Next.js default files)
/backup_boilerplate

# playwright test results
/test-results/
.vercel

# Cloudflare Tunnel configs
cloudflared.config.yml

# Temporary scratch and database dumps
scratch/
dump.rdb
tunnel-url.txt

# Binaries and archives
/tools/cloudflared/cloudflared.exe
/tools/redis/Redis-x64/
/tools/redis/Redis-x64.zip
/tools/redis/dump.rdb

# Logs
/docs/archive/logs/

# OpenCode agent session continuations
.omo/

# Temporary test output
test-output.txt

# Investigation scripts & tools (forensic, diagnostic — not production code)
scripts/tools/

# Dev logs and build info
server.log
vercel-logs.txt
tsconfig.tsbuildinfo

# Archived secrets (sensitive credentials backup — excluded from git tracking)
_archive/secrets/


